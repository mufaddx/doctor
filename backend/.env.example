NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/touch_of_cure?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Firebase (Auth + Storage + FCM)
FIREBASE_PROJECT_ID=touch-of-cure
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@touch-of-cure.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=touch-of-cure.appspot.com

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Agora video calling
AGORA_APP_ID=xxxxxxxxxxxx
AGORA_APP_CERTIFICATE=xxxxxxxxxxxx

# MSG91 SMS
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_RESET_TEMPLATE_ID=

# Platform config
PLATFORM_FEE=20
REFERRAL_BONUS=100
